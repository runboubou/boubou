[Unit]
Description=Boubou names: DNS and certificates for Boubou on local networks
Wants=network-online.target
After=network-online.target

[Service]
# Replace 203.0.113.7 with this server's public IPv4 address.
ExecStart=/usr/local/bin/boubou-names --address 203.0.113.7
DynamicUser=yes
StateDirectory=boubou-names
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
